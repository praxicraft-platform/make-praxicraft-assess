{
  "url": "/interviews/org-tasks/",
  "method": "GET",
  "qs": {
    "{{...}}": "{{parameters}}"
  },
  "response": {
    "output": "{{item}}",
    "iterate": "{{if(body.results, body.results, emptyarray)}}",
    "limit": "{{ifempty(parameters.page_size, 20)}}"
  },
  "pagination": {
    "url": "{{body.next}}",
    "method": "GET",
    "condition": "{{if(body.next, true, false)}}"
  }
}
