{
  "url": "/interviews/templates/{{parameters.id}}/update/",
  "method": "PATCH",
  "body": {
    "{{...}}": "{{omit(parameters, 'id', 'config_json', 'config')}}",
    "config": "{{if(length(trim(parameters.config_json)) > 0, parseJSON(parameters.config_json), undefined)}}"
  },
  "type": "json",
  "response": {
    "output": "{{body}}"
  }
}
